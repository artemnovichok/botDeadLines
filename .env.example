# Скопируйте файл: cp .env.example .env && chmod 600 .env
# Настоящие секреты храните только в .env/окружении или менеджере секретов.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# Для подключения аккаунтов нужен HTTPS origin с действующим сертификатом.
# HTTP localhost разрешён только для healthcheck и просмотра страницы без входа.
# start.command на Mac сам задаёт https://localhost:8443 в локальном Docker-профиле.
PUBLIC_BASE_URL=http://localhost:8000
# Точные IP доверенного reverse proxy, видимые приложению; не используйте *.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Токен из BotFather. Для чтения личных чатов одного Bot Token недостаточно.
TELEGRAM_BOT_TOKEN=
# Собственные API ID и API hash с https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ключ из кабинета LowRouter, раздел API-ключи.
LOWROUTER_API_KEY=
LLM_BASE_URL=https://api.lowrouter.ru/v1
# Идентификатор должен присутствовать в текущем каталоге вашего провайдера.
LLM_MODEL=gpt-6-luna
# Бюджет входа в токенах; GPT считается токенизатором, для неизвестных моделей — UTF-8 верхняя оценка.
# Схема, память и исходные сообщения учитываются целиком, без обрезки.
LLM_MAX_INPUT_TOKENS=30000
LLM_MAX_OUTPUT_TOKENS=6000
# Необязательная кодировка для оценки входа. GPT-6 в старом tiktoken использует o200k_base.
LLM_TOKEN_ENCODING=
# Пустое значение: GPT-6 использует low; прочие модели — настройки провайдера.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120
# Потоковый ответ; включайте, если ваш OpenAI-совместимый шлюз поддерживает SSE и include_usage.
LLM_STREAM=false
# Только повторы явных отказов 429. Таймауты/обрывы/5xx автоматически не повторяются.
LLM_MAX_RETRIES=3
LLM_FORMAT_RETRIES=2
LLM_MEMORY_EVENT_LIMIT=200
LLM_JSON_MODE=true
LLM_STRUCTURED_OUTPUT=true
# Общий максимум параллельных LLM-запросов обычных серверных/CLI циклов.
LLM_CONCURRENCY=3
CYCLE_CONCURRENCY=4

# SQLite для небольшого сервера. PostgreSQL: postgresql+asyncpg://user:password@host/db
# БД не публикуется в интернет. Путь отсчитывается от корня проекта (/app в Docker).
DATABASE_URL=sqlite+aiosqlite:///./data/deadline.db
# Сгенерируйте Fernet-ключ командой из README; сохраните отдельно от БД.
SESSION_ENCRYPTION_KEY=
DEFAULT_TIMEZONE=Europe/Moscow
# Местные часы пользователя от 0 до 23. Время сводки меняется также через /settings.
DAILY_SYNC_HOUR=2
DAILY_DIGEST_HOUR=8
DIGEST_CATCHUP_HOURS=6
DELIVERY_MAX_ATTEMPTS=5
# Однократный первый анализ выбранных чатов, максимум 100 сообщений на чат.
INITIAL_MESSAGE_LIMIT=100
# История старше этого окна пропускается; проверка известных источников не ограничена.
MESSAGE_MAX_AGE_DAYS=90
SYNC_BATCH_SIZE=50
EDIT_LOOKBACK_LIMIT=100
RETENTION_DAYS=30
# Максимальное время без прогресса; после сохранения каждой порции отсчитывается заново.
SYNC_TIMEOUT_SECONDS=600
# Мягкие пределы одного запуска. Текущая порция завершается и сохраняется, затем придёт сводка.
SYNC_MAX_DURATION_SECONDS=300
SYNC_MAX_TOTAL_TOKENS=100000
# Сообщения о текущем прогрессе в боте; дополнительных запросов к ИИ нет.
ANALYSIS_PROGRESS_INTERVAL_SECONDS=120
JOB_LOCK_TIMEOUT_SECONDS=30
# Интервалы запросов к MTProto и Bot API; FloodWait дополнительно учитывается.
TELEGRAM_REQUEST_INTERVAL=0.15
BOT_REQUEST_INTERVAL=0.05
RETRY_ATTEMPTS=3
LOG_LEVEL=INFO
# При необходимости прямого HTTPS без reverse proxy задаются оба пути внутри сервера:
# TLS_CERT_FILE=/path/to/certificate.pem
# TLS_KEY_FILE=/path/to/private-key.pem
# Только для compose.postgres.yaml: длинный случайный пароль из букв и цифр.
# POSTGRES_PASSWORD=
